{
  "setup": {
    "command": "cmake -S . -B build -G Ninja -DCMAKE_CXX_COMPILER=g++",
    "creates": "build/build.ninja"
  },
  "build": "cmake --build build --target p{id}",
  "run": "build/p{id}.exe {input} {output}",
  "reference": {
    "build": "cmake --build build --target ref_p{id}",
    "run": "build/ref_p{id}.exe {input} {output}"
  },
  "timeoutSeconds": 10,
  "book": {
    "title": "Tiny TrueType Workbook",
    "sourceUrl": "https://yayo1.com/en/blog/tiny-truetype-renderer/",
    "sourceTitle": "Writing a tiny TrueType parser and renderer from scratch",
    "author": "Yohei Yamasaki",
    "headline": "Build a TrueType renderer yourself",
    "lede": "Each checkpoint asks you to write the program that one part of the blog post builds, from reading big-endian bytes to drawing a line of text. A checker feeds your program inputs and compares what it writes with answers worked out independently, mostly by fontTools. How you structure the code, and which language or library you use, is up to you.",
    "credits": "Fonts: JetBrains Mono (Nerd Font build) and Noto Sans JP, both under the SIL Open Font License. Expected outputs come from fontTools. Progress is saved in this browser only."
  },
  "checkpoints": {
    "01": {
      "title": "Read big-endian numbers",
      "solution": "solutions/p01_byte_readers.cpp",
      "problem": "problems/01-byte-readers.md",
      "cases": "tests/01/cases.txt",
      "generator": "py -P tools/gen_p01.py --seed {seed} --out {out}"
    },
    "02": {
      "title": "Read the table directory",
      "solution": "solutions/p02_table_directory.cpp",
