---
import { href } from '../lib/paths.mjs';
interface Props { title: string; description?: string; }
const { title, description = 'We turn tech blog posts and papers into byte-sized coding assignments. Solve them one at a time and you build what the post describes.' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23ffa116'/%3E%3Cpath d='M9 10h14M9 16h14M9 22h8' stroke='%23fff' stroke-width='3' stroke-linecap='round'/%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
  <script is:inline>
    try { var t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  <style is:global>
    /* Tokens are the problem book's own, so the index and the books look like one product. */
    :root {
      --font-ui: "Geist", -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Helvetica, Arial, sans-serif;
      --font-mono: "JetBrains Mono", Menlo, Monaco, Consolas, "Courier New", monospace;
      --bg: #f0f0f0; --layer: #ffffff; --layer-head: #fafafa; --fill: #f2f3f5; --fill-hover: #e7e8eb; --row-alt: #f7f8fa;
      --line: #e7e7e7; --line-strong: #d4d4d8; --text: #262626; --text-2: #595959; --text-3: #8c8c8c;
      --brand: #ffa116; --brand-ink: #b46a00; --link: #0a6fd8;
      --easy: #00a38f; --medium: #c98300; --hard: #f02a50; --ok: #2db55d; --on-color: #ffffff; --code-bg: #f5f6f7;
      --term-bg: #1f2125; --term-head: #2a2d33; --term-text: #e6e7ea; --term-dim: #8b8f98; --term-line: #3a3d44;
      --shadow: 0 1px 2px rgba(20, 20, 30, 0.05), 0 6px 20px rgba(20, 20, 30, 0.06);
    }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        --bg: #1a1a1a; --layer: #262626; --layer-head: #2d2d2d; --fill: #353535; --fill-hover: #404040; --row-alt: #2b2b2b;
        --line: #383838; --line-strong: #4a4a4a; --text: #e8e8ea; --text-2: #a9aaae; --text-3: #75767a;
        --brand-ink: #ffa116; --link: #4ea1ff; --easy: #00b8a3; --medium: #ffc01e; --hard: #ff375f; --ok: #2cbb5d; --code-bg: #2f2f2f;
        --term-bg: #151618; --term-head: #202226; --term-line: #30333a; --shadow: 0 1px 2px rgba(0, 0, 0, 0.3), 0 6px 20px rgba(0, 0, 0, 0.25);
      }
    }
    :root[data-theme="dark"] {
      --bg: #1a1a1a; --layer: #262626; --layer-head: #2d2d2d; --fill: #353535; --fill-hover: #404040; --row-alt: #2b2b2b;
      --line: #383838; --line-strong: #4a4a4a; --text: #e8e8ea; --text-2: #a9aaae; --text-3: #75767a;
      --brand-ink: #ffa116; --link: #4ea1ff; --easy: #00b8a3; --medium: #ffc01e; --hard: #ff375f; --ok: #2cbb5d; --code-bg: #2f2f2f;
      --term-bg: #151618; --term-head: #202226; --term-line: #30333a; --shadow: 0 1px 2px rgba(0, 0, 0, 0.3), 0 6px 20px rgba(0, 0, 0, 0.25);
    }
    * { box-sizing: border-box; }
    html { color-scheme: light dark; scroll-behavior: smooth; }
    :root[data-theme="light"] { color-scheme: light; }
    :root[data-theme="dark"] { color-scheme: dark; }
    body { margin: 0; background: var(--bg); color: var(--text); font: 14px/1.6 var(--font-ui); -webkit-font-smoothing: antialiased; }
    a { color: var(--link); text-decoration: none; }
    a:hover { text-decoration: underline; text-underline-offset: 2px; }
    code, pre, kbd { font-family: var(--font-mono); }
    :focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; border-radius: 4px; }
    h1, h2, h3 { text-wrap: balance; }
    .wrap { max-width: 1440px; margin: 0 auto; padding-left: max(clamp(16px, 3vw, 40px), env(safe-area-inset-left, 0px)); padding-right: max(clamp(16px, 3vw, 40px), env(safe-area-inset-right, 0px)); }
    .topbar { background: var(--layer); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 20; }
    .topbar .wrap { display: flex; align-items: center; gap: 16px; height: 54px; }
    .brand { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 16px; letter-spacing: -0.01em; color: var(--text); }
    .brand:hover { text-decoration: none; }
    .brand i { width: 24px; height: 24px; border-radius: 7px; background: var(--brand); display: grid; place-items: center; }
    .brand i svg { width: 14px; height: 14px; }
    .topbar nav { margin-left: auto; display: flex; gap: 6px; align-items: center; }
    .topbar nav a { color: var(--text-2); padding: 5px 10px; border-radius: 6px; font-weight: 500; }
    .topbar nav a:hover { background: var(--fill); color: var(--text); text-decoration: none; }
    .icon-btn { display: grid; place-items: center; width: 32px; height: 32px; border: 0; border-radius: 6px; background: none; color: var(--text-2); cursor: pointer; }
    .icon-btn:hover { background: var(--fill); color: var(--text); }
    .icon-btn svg { width: 17px; height: 17px; }
    .btn { display: inline-flex; align-items: center; gap: 7px; border: 1px solid var(--line-strong); background: var(--layer); color: var(--text); border-radius: 8px; padding: 8px 14px; font: inherit; font-weight: 600; cursor: pointer; transition: background 0.12s ease, border-color 0.12s ease; }
    .btn:hover { background: var(--fill); text-decoration: none; }
    .btn.primary { background: var(--brand); border-color: var(--brand); color: #1a1a1a; }
    .btn.primary:hover { background: color-mix(in srgb, var(--brand) 88%, #fff); }
    .btn.small { padding: 4px 10px; font-size: 12px; border-radius: 6px; }
    main { padding-block: 32px 64px; }
    .card { background: var(--layer); border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--shadow); }
    .chip { display: inline-block; background: var(--fill); color: var(--text-2); border-radius: 999px; padding: 0 9px; font-size: 12px; line-height: 20px; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .easy { color: var(--easy); } .medium { color: var(--medium); } .hard { color: var(--hard); }
    .scroll-x { overflow-x: auto; }
    footer { color: var(--text-3); font-size: 12px; border-top: 1px solid var(--line); background: var(--layer); }
    footer .wrap { display: flex; gap: 8px 24px; flex-wrap: wrap; justify-content: space-between; padding-block: 22px 28px; }
    @media (max-width: 720px) { .hide-sm { display: none !important; } main { padding-block: 22px 48px; } .topbar nav a.opt-nav { display: none; } }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } .btn { transition: none; } }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="wrap">
      <a class="brand" href={href('/')}><i><svg viewBox="0 0 32 32"><path d="M6 8h20M6 16h20M6 24h12" stroke="#fff" stroke-width="4" stroke-linecap="round" fill="none"/></svg></i>Workbooks</a>
      <nav>
        <a class="opt-nav" href="https://github.com/knmn2000/techblog-workbooks#contributing">Contribute</a>
        <a href="https://github.com/knmn2000/techblog-workbooks">GitHub</a>
        <button class="icon-btn" id="theme" type="button" title="Switch light and dark theme" aria-label="Switch light and dark theme">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
      </nav>
    </div>
  </header>
  <main><div class="wrap"><slot /></div></main>
  <footer><div class="wrap">
    <span>Each workbook links to the post it teaches from and contains none of its text or code.</span>
    <span>Workbook content is Apache-2.0. Fonts and third-party code keep their own licences.</span>
  </div></footer>
  <script is:inline>
    document.getElementById('theme').addEventListener('click', function () {
      var el = document.documentElement;
      var dark = el.dataset.theme ? el.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      var next = dark ? 'light' : 'dark';
      el.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch (e) {}
    });
  </script>
</body>
</html>
