---
// One folder of the project tree: a native <details>, so Enter and Space open and close it with the
// keyboard and nothing is stored between visits. Folders open down to the second level.
import TreeDir from './TreeDir.astro';
const { node, unit, depth = 0 } = Astro.props;
const Unit = unit[0].toUpperCase() + unit.slice(1);
const label = (f) => (f.owner === 'all' ? `Every ${unit}` : `${Unit} ${f.owner}`);
---
<details class="t-dir" open={depth < 2}>
  <summary class="t-dname">{node.name}</summary>
  <div class="t-kids">
    {node.dirs.map((d) => <TreeDir node={d} unit={unit} depth={depth + 1} />)}
    {node.files.map((f) => (
      <div class="t-file" title={f.purpose}>
        <code class="t-name">{f.name}</code>
        <span class="t-n">{label(f)}{f.adds.length > 0 && <span class="t-adds">+ {f.adds.join(', ')}</span>}</span>
        <span class="t-why" set:html={f.purposeHtml}></span>
      </div>
    ))}
  </div>
</details>

<style>
  .t-dname { font: 400 12.5px var(--font-mono); padding: 8px 18px; color: var(--text-3); background: var(--layer-head); border-bottom: 1px solid var(--line); cursor: pointer; list-style: none; }
  .t-dname::-webkit-details-marker { display: none; }
  .t-dname::before { content: '▸'; display: inline-block; width: 1.4em; transition: transform 0.12s ease; }
  details[open] > .t-dname::before { transform: rotate(90deg); }
  .t-dname:hover { color: var(--text); }
  .t-dname:focus-visible { outline: 2px solid var(--brand); outline-offset: -2px; }
  .t-kids { margin-left: 18px; border-left: 1px solid var(--line); }
  .t-file { display: grid; grid-template-columns: minmax(0, 200px) 112px minmax(0, 1fr); gap: 4px 14px; padding: 8px 18px 8px 14px; border-bottom: 1px solid var(--line); align-items: baseline; }
  .t-name { font: 500 12.5px var(--font-mono); color: var(--text); overflow-wrap: anywhere; }
  .t-n { font: 400 12px var(--font-mono); color: var(--brand-ink); }
  .t-adds { display: block; color: var(--text-3); }
  .t-why { color: var(--text-2); font-size: 13px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  @media (max-width: 640px) { .t-file { grid-template-columns: minmax(0, 1fr) auto; } .t-why { grid-column: 1 / -1; } }
  @media (prefers-reduced-motion: reduce) { .t-dname::before { transition: none; } }
</style>
