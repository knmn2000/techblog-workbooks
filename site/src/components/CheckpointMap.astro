---
// One square per checkpoint, coloured by difficulty: the shape of the workbook at a glance.
interface Props {
  checkpoints: { id: string; title: string; difficulty: string | null }[];
  counts: Record<string, number>;
  unit?: string;
  size?: 'sm' | 'lg';
  link?: boolean;
  legend?: boolean;
}
const { checkpoints, counts, unit = 'checkpoint', size = 'sm', link = false, legend = true } = Astro.props;
const cls = (d: string | null) => (d ? d.toLowerCase() : 'tbd');
// Break the strip into evenly filled rows (18 becomes 9 + 9, never 12 + 6).
const maxCols = size === 'lg' ? 12 : 10;
const cols = Math.ceil(checkpoints.length / Math.ceil(checkpoints.length / maxCols));
const pending = checkpoints.filter((c) => !c.difficulty).length;
---
<div class={`map ${size}`}>
  <div class="dots" style={`--cols:${cols}`} role="img" aria-label={`${checkpoints.length} ${unit}s:${counts.Easy ?? 0} easy, ${counts.Medium ?? 0} medium, ${counts.Hard ?? 0} hard`}>
    {checkpoints.map((c) => {
      const label = `${c.id} · ${c.title} · ${c.difficulty ?? 'not written yet'}`;
      return link
        ? <a class={`dot ${cls(c.difficulty)}`} href={`#cp-${c.id}`} title={label} aria-label={label}></a>
        : <i class={`dot ${cls(c.difficulty)}`} title={label}></i>;
    })}
  </div>
  {legend && (
    <div class="legend">
      {counts.Easy > 0 && <span class="easy"><b>{counts.Easy}</b> easy</span>}
      {counts.Medium > 0 && <span class="medium"><b>{counts.Medium}</b> medium</span>}
      {counts.Hard > 0 && <span class="hard"><b>{counts.Hard}</b> hard</span>}
      {pending > 0 && <span class="tbd-l"><b>{pending}</b> in progress</span>}
    </div>
  )}
</div>
<style>
  .map { display: flex; flex-direction: column; gap: 7px; min-width: 0; }
  .dots { display: grid; grid-template-columns: repeat(var(--cols), 11px); gap: 3px; }
  .lg .dots { grid-template-columns: repeat(var(--cols), 20px); gap: 5px; }
  .dot { display: block; width: 11px; height: 11px; border-radius: 3px; background: var(--fill-hover); transition: transform 0.12s ease; }
  .lg .dot { width: 20px; height: 20px; border-radius: 5px; }
  a.dot:hover { transform: translateY(-2px); }
  a.dot:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  .dot.easy { background: var(--easy); }
  .dot.medium { background: var(--medium); }
  .dot.hard { background: var(--hard); }
  .dot.tbd { background: transparent; box-shadow: inset 0 0 0 1.5px var(--line-strong); }
  .tbd-l { color: var(--text-3); }
  .legend { display: flex; flex-wrap: wrap; gap: 4px 12px; font-size: 12px; color: var(--text-2); }
  .legend b { font-weight: 600; font-variant-numeric: tabular-nums; }
  @media (prefers-reduced-motion: reduce) { .dot { transition: none; } }
</style>
