---
import Base from '../../../layouts/Base.astro';
import CheckpointMap from '../../../components/CheckpointMap.astro';
import TreeDir from '../../../components/TreeDir.astro';
import { loadWorkbooks, REPO_URL } from '../../../lib/workbooks.mjs';
import { startPanelHtml, startPanelCss, startPanelJs } from '../../../lib/start-ui.mjs';
import { href } from '../../../lib/paths.mjs';

export function getStaticPaths() {
  return loadWorkbooks().map((w) => ({ params: { slug: w.slug }, props: { w } }));
}
const { w } = Astro.props;
const panel = startPanelHtml(w, { id: 'start', prefix: 'page', heading: 'Run it locally', lead: false, sourceUrl: `${REPO_URL}/tree/main/workbooks/${w.slug}` });
const bookUrl = (id: string) => href(`/w/${w.slug}/book.html#p${id}`);
const first = w.checkpoints[0];
// The driver programs sit beside src/ in the project but are not in the workbook's file list.
const tree = w.project && {
  ...w.project.tree,
  dirs: [
    ...w.project.tree.dirs,
    { name: 'assignments/', dirs: [], files: [{ name: 'assignment_NN_….*', owner: 'all', adds: [], purpose: '', purposeHtml: `A small driver for each ${w.unit}. It reads the test input, calls into your project and prints the answer the checker compares.` }] },
  ],
};
---
<Base title={`${w.title} · Workbooks`} description={w.headline} image={`/og/${w.slug}.png`}>
  <nav class="crumb" aria-label="Breadcrumb"><a href={href('/')}>All workbooks</a><span aria-hidden="true">/</span><span>{w.title}</span></nav>

  <header class="head">
    <h1>{w.title}</h1>
    <p class="headline">{w.headline}</p>
    <p class="built">Built on <a href={w.source.url} rel="noopener">{w.source.title}</a> by {w.source.author}. Keep the post open in another tab: each {w.unit} links to the section it covers.</p>
    <a class="btn run-link" href="#start">Run it locally</a>
  </header>

  <div class="layout">
    <div class="main">
      <section class="card here" aria-labelledby="here">
        <h2 id="here">Start here</h2>
        <ol class="here-steps">
          <li>Get a local copy. Clone it yourself, or give the prompt under <a href="#start">Run it locally</a> to your coding assistant. The book runs your code on your machine, so it needs the files there.</li>
          <li>Open the book and set up your {w.language} project. Each {w.unit} opens with a Start here card that names the files to write and what each should do.</li>
          <li>Start at {w.unit} {first?.id}{first ? ` (${first.title})` : ''} and work down the list; later ones build on the files you write now.{w.hasBook && first ? <> <a href={bookUrl(first.id)}>Read it now</a>.</> : ''}</li>
        </ol>
      </section>

      <section class="card list" aria-labelledby="cps">
        <div class="list-head">
          <div class="lh-top">
            <h2 id="cps">{w.units}</h2>
            <CheckpointMap checkpoints={w.checkpoints} counts={w.counts} unit={w.unit} link />
          </div>
        </div>
        <div class="scroll-x">
          <table>
            <thead><tr><th class="idc">#</th><th class="tc">Title</th><th class="hide-sm cc">Concepts</th><th class="dc">Difficulty</th></tr></thead>
            <tbody>
              {w.checkpoints.map((c) => (
                <tr id={`cp-${c.id}`} class={w.hasBook ? 'go' : ''}>
                  <td class="idc">{c.id}</td>
                  <td class="t">{w.hasBook ? <a href={bookUrl(c.id)}>{c.title}</a> : c.title}</td>
                  <td class="hide-sm"><div class="tags">{c.concepts.slice(0, 2).map((t) => <span class="chip">{t}</span>)}</div></td>
                  <td>{c.difficulty ? <span class={`diff ${c.difficulty.toLowerCase()}`}>{c.difficulty}</span> : <span class="diff pending">In progress</span>}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      {w.project && (
        <section class="card proj" aria-labelledby="proj">
          <div class="proj-head">
            <h2 id="proj">Project structure</h2>
            <p>Each file shows the {w.unit} that creates it. A <code>+</code> lists the later ones that add to it.</p>
          </div>
          <div class="tree">
            <TreeDir node={tree} unit={w.unit} />
          </div>
        </section>
      )}

      <section class="about">
        <h2>About this workbook</h2>
        <p>{w.lede}</p>
        {w.credits && <p class="credits">{w.credits.replace(/\s*[^.]*in this browser only\.?/i, '')}</p>}
      </section>
    </div>

    <aside class="side">
      <div class="card start" set:html={panel}></div>
    </aside>
  </div>

  <style is:global set:html={startPanelCss}></style>
  <script is:inline set:html={startPanelJs}></script>
</Base>

<style>
  .crumb { display: flex; gap: 8px; color: var(--text-3); margin: 0 0 20px; font-size: 13px; flex-wrap: wrap; }
  .crumb a { color: var(--text-2); }
  .head { margin-bottom: 28px; }
  h1 { font-size: clamp(26px, 4vw, 34px); line-height: 1.15; margin: 0 0 8px; letter-spacing: -0.025em; font-weight: 700; }
  h2 { font-size: 18px; margin: 0; letter-spacing: -0.01em; }
  .headline { font-size: 18px; line-height: 1.45; color: var(--text); margin: 0 0 10px; max-width: 34em; }
  .built { color: var(--text-2); margin: 0; max-width: 62ch; }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 28px; align-items: start; }
  .main { min-width: 0; display: grid; gap: 32px; }
  .side { position: sticky; top: 74px; min-width: 0; }
  .lh-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px 24px; flex-wrap: wrap; }
  .start { padding: 16px; scroll-margin-top: 76px; max-height: calc(100vh - 90px); overflow-y: auto; }
  .list { overflow: hidden; }
  .list-head { padding: 18px 18px 14px; }
  table { width: 100%; border-collapse: collapse; table-layout: fixed; }
  .tc { width: 36%; }
  .dc { width: 96px; }
  .tags .chip { white-space: normal; border-radius: 10px; line-height: 1.35; padding: 2px 9px; }
  th { text-align: left; font-weight: 500; font-size: 12px; color: var(--text-3); padding: 9px 16px; background: var(--layer-head); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); white-space: nowrap; }
  td { padding: 12px 16px; border-bottom: 1px solid var(--line); vertical-align: top; }
  tr:last-child td { border-bottom: 0; }
  tbody tr { position: relative; scroll-margin-top: 70px; transition: background 0.12s ease; }
  tbody tr:hover { background: var(--row-alt); }
  tbody tr:target { background: color-mix(in srgb, var(--brand) 14%, transparent); }
  tr.go { cursor: pointer; }
  .idc { width: 52px; color: var(--text-3); font: 400 12.5px var(--font-mono); padding-top: 14px; }
  .t { font-weight: 500; }
  .t a { color: var(--text); }
  .t a:hover { color: var(--brand-ink); text-decoration: none; }
  .t a::after { content: ''; position: absolute; inset: 0; }
  .t a:focus-visible { outline: none; }
  tr.go:has(a:focus-visible) { outline: 2px solid var(--brand); outline-offset: -2px; }
  .tags { display: flex; flex-wrap: wrap; gap: 5px; }
  .diff { font-weight: 500; }
  .diff.pending { color: var(--text-3); font-weight: 400; }
  .here { padding: 18px 20px; }
  .here h2 { margin-bottom: 10px; }
  .here-steps { margin: 0; padding-left: 20px; display: grid; gap: 8px; color: var(--text-2); line-height: 1.6; }
  .proj { overflow: hidden; }
  .proj-head { padding: 18px 18px 12px; }
  .proj-head p { color: var(--text-2); margin: 6px 0 0; max-width: 66ch; }
  .proj-head code { font: 400 12.5px var(--font-mono); }
  .tree { border-top: 1px solid var(--line); }
  .about { max-width: 66ch; }
  .about h2 { margin-bottom: 6px; }
  .about p { color: var(--text-2); margin: 0; line-height: 1.7; }
  .about .credits { color: var(--text-3); font-size: 12px; margin-top: 12px; }
  .run-link { display: none; }
  @media (max-width: 960px) {
    .layout { grid-template-columns: minmax(0, 1fr); }
    .tc { width: auto; }
    .side { position: static; }
    .start { max-height: none; overflow: visible; }
    .run-link { display: inline-flex; margin-top: 16px; }
  }
  @media (prefers-reduced-motion: reduce) { tbody tr { transition: none; } }
</style>
